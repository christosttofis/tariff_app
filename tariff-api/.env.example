# Copy to .env and fill in real values for local dev. See config.py for how
# each of these is used and what happens when one is left unset.

# JWT signing secret — required. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
TARIFF_SECRET_KEY=

# Set to 1 ONLY for local dev to use a well-known insecure fallback signing
# key instead of TARIFF_SECRET_KEY. Never set this outside local dev.
TARIFF_ALLOW_DEV_SECRET=0

# PostgreSQL connection string. Falls back to a local SQLite file if unset
# (fine for local dev/demo, wrong for anything shared).
DATABASE_URL=postgresql://user:password@localhost:5432/tariff

# Public base URL this app is served from — used for CORS, and for links in
# outgoing emails (OTP codes, password resets, notifications).
TARIFF_BASE_URL=http://localhost:8000

# Set to 0 to disable /docs, /redoc and /openapi.json (recommended in
# production — otherwise the full route/schema surface is public).
TARIFF_ENABLE_DOCS=1

# Azure AD / Microsoft Graph app registration used to send outgoing email.
# If any of these (or TARIFF_EMAIL_FROM) are left blank, email sending
# silently no-ops instead of failing the request that triggered it.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TARIFF_EMAIL_FROM=
TARIFF_ADMIN_EMAIL=
